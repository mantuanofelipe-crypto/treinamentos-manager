@page
@model TreinamentosManager.Pages.Conformidade.RelatorioModel
@{
    ViewData["Title"] = "Relatório de Conformidade";
}

<div class="card shadow-sm mb-3">
    <div class="card-header-dk d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div class="d-flex align-items-center gap-2">
            <i class="fas fa-chart-line"></i>
            <h5 class="mb-0">Relatório de Conformidade</h5>
        </div>
        <a asp-page="./Index" class="btn btn-dk-secondary btn-sm">
            <i class="fas fa-arrow-left me-1"></i>Voltar
        </a>
    </div>
    <div class="card-body">
        <div class="row g-2 mb-3">
            <div class="col-md-3">
                <div class="stat-card stat-card-total shadow-sm py-2">
                    <div class="fs-4 fw-bold">@Model.MediaGeral.ToString("0.#")%</div>
                    <div class="opacity-90 small">Média geral</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card stat-card-futura shadow-sm py-2">
                    <div class="fs-4 fw-bold">@Model.MediaInstrutor.ToString("0.#")%</div>
                    <div class="opacity-90 small">Média instrutor</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card stat-card-andamento shadow-sm py-2">
                    <div class="fs-4 fw-bold">@Model.MediaCoordenacao.ToString("0.#")%</div>
                    <div class="opacity-90 small">Média coordenação</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card stat-card-concluida shadow-sm py-2">
                    <div class="fs-4 fw-bold">@Model.TotalTurmasComConformidade</div>
                    <div class="opacity-90 small">Turmas avaliadas</div>
                </div>
            </div>
        </div>

        <div class="shadow-sm rounded p-3 bg-white border">
            <h6 class="fw-bold mb-2"><i class="fas fa-chart-area me-2" style="color:#D79A00"></i>Evolução das notas ao longo do tempo</h6>
            <canvas id="graficoConformidade"></canvas>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Labels));
    const geral = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Geral));
    const instrutor = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Instrutor));
    const coordenacao = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Coordenacao));

    new Chart(document.getElementById('graficoConformidade'), {
        type: 'line',
        data: {
            labels,
            datasets: [
                { label: 'Geral', data: geral, borderColor: '#0d6efd', backgroundColor: 'rgba(13,110,253,.08)', tension: .3, fill: true },
                { label: 'Instrutor', data: instrutor, borderColor: '#D79A00', backgroundColor: 'rgba(215,154,0,.05)', tension: .3 },
                { label: 'Coordenação', data: coordenacao, borderColor: '#198754', backgroundColor: 'rgba(25,135,84,.05)', tension: .3 }
            ]
        },
        options: {
            responsive: true,
            aspectRatio: 3.4,
            plugins: { legend: { position: 'top' } },
            scales: { y: { min: 0, max: 100, title: { display: true, text: 'Conformidade (%)' } } }
        }
    });
</script>
}
