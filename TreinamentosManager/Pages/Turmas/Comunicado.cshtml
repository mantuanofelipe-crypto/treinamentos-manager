@page "{id:int}"
@model TreinamentosManager.Pages.Turmas.ComunicadoModel
@{
    ViewData["Title"] = "Enviar Comunicado";
}

<div class="card shadow-sm">
    <div class="card-header-dk d-flex align-items-center gap-2">
        <i class="fas fa-envelope"></i>
        <h5 class="mb-0">Enviar Comunicado</h5>
    </div>
    <div class="card-body p-4">
        @if (!string.IsNullOrWhiteSpace(Model.Mensagem))
        {
            <div class="alert alert-@(Model.TipoMensagem ?? "info")">@Model.Mensagem</div>
        }

        <form method="post">
            <input type="hidden" asp-for="TurmaId" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3">
                <label asp-for="Emails" class="form-label form-label-dk">Emails dos destinatários</label>
                <textarea asp-for="Emails" class="form-control" rows="3" placeholder="email1@empresa.com; email2@empresa.com"></textarea>
                <span asp-validation-for="Emails" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Assunto" class="form-label form-label-dk">Assunto</label>
                <input asp-for="Assunto" class="form-control" />
                <span asp-validation-for="Assunto" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Conteudo" class="form-label form-label-dk">Texto do convite</label>
                <div class="form-text mb-2">O email será enviado com a arte do convite no corpo. Este texto fica como versão simples do email.</div>
                <textarea asp-for="Conteudo" class="form-control comunicado-textarea" rows="22"></textarea>
                <span asp-validation-for="Conteudo" class="text-danger small"></span>
            </div>

            <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
                <div class="form-check">
                    <input asp-for="AnexarConvitePptx" class="form-check-input" />
                    <label asp-for="AnexarConvitePptx" class="form-check-label">Também anexar convite em PowerPoint</label>
                </div>
                <a asp-page-handler="Download" asp-route-id="@Model.TurmaId" class="btn btn-outline-secondary btn-sm">
                    <i class="fas fa-download me-1"></i> Baixar convite personalizado
                </a>
            </div>

            <div class="section-divider"></div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-dk-primary btn-lg px-4">
                    <i class="fas fa-paper-plane me-1"></i> Enviar Comunicado
                </button>
                <a asp-page="./Index" class="btn btn-dk-secondary btn-lg px-4">
                    <i class="fas fa-arrow-left me-1"></i> Voltar
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
