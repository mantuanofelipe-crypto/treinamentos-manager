@page "{id:int}"
@model TreinamentosManager.Pages.Turmas.EditModel
@{
    ViewData["Title"] = "Editar Turma";
}

<div class="card shadow-sm">
    <div class="card-header-dk d-flex align-items-center gap-2">
        <i class="fas fa-edit"></i>
        <h5 class="mb-0">Editar Turma</h5>
    </div>
    <div class="card-body p-4">
        <form method="post">
            <input type="hidden" asp-for="Turma.Id" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="row g-3 mb-3">
                <div class="col-md-12">
                    <label asp-for="Turma.Nome" class="form-label form-label-dk">Nome da Turma <span class="text-danger">*</span></label>
                    <input asp-for="Turma.Nome" class="form-control" required />
                    <span asp-validation-for="Turma.Nome" class="text-danger small"></span>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label asp-for="Turma.IdAutodesk" class="form-label form-label-dk">ID Autodesk</label>
                    <input asp-for="Turma.IdAutodesk" class="form-control" />
                    <span asp-validation-for="Turma.IdAutodesk" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Turma.CargaHoraria" class="form-label form-label-dk">Carga Horária (horas)</label>
                    <input asp-for="Turma.CargaHoraria" class="form-control" type="number" min="1" />
                    <span asp-validation-for="Turma.CargaHoraria" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Turma.Modalidade" class="form-label form-label-dk">Modalidade</label>
                    <select asp-for="Turma.Modalidade" class="form-select">
                        <option value="Presencial">Presencial</option>
                        <option value="Online">Online</option>
                    </select>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="Turma.TipoCliente" class="form-label form-label-dk">Tipo de Cliente</label>
                    <select asp-for="Turma.TipoCliente" class="form-select">
                        <option value="Turmas Gerenciável">Turmas Gerenciável</option>
                        <option value="Turmas Abertas">Turmas Abertas</option>
                    </select>
                    <span asp-validation-for="Turma.TipoCliente" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Turma.Conformidade" class="form-label form-label-dk">Conformidade</label>
                    <input asp-for="Turma.Conformidade" class="form-control" />
                    <span asp-validation-for="Turma.Conformidade" class="text-danger small"></span>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="Turma.ClienteId" class="form-label form-label-dk">Cliente <span class="text-danger">*</span></label>
                    <select asp-for="Turma.ClienteId" class="form-select" asp-items="ViewBag.ClienteId" required>
                        <option value="">— Selecione um Cliente —</option>
                    </select>
                    <span asp-validation-for="Turma.ClienteId" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Turma.SoftwareId" class="form-label form-label-dk">Software <span class="text-danger">*</span></label>
                    <select asp-for="Turma.SoftwareId" class="form-select" asp-items="ViewBag.SoftwareId" required>
                        <option value="">— Selecione um Software —</option>
                    </select>
                    <span asp-validation-for="Turma.SoftwareId" class="text-danger small"></span>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="Turma.Inicio" class="form-label form-label-dk">Data de Início <span class="text-danger">*</span></label>
                    <input asp-for="Turma.Inicio" class="form-control" type="datetime-local" id="dtInicio" />
                    <span asp-validation-for="Turma.Inicio" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Turma.Fim" class="form-label form-label-dk">Data de Fim <span class="text-danger">*</span></label>
                    <input asp-for="Turma.Fim" class="form-control" type="datetime-local" id="dtFim" />
                    <span asp-validation-for="Turma.Fim" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label form-label-dk">Datas das Turmas <span class="text-danger">*</span></label>
                <div id="datasTurma" class="d-grid gap-2">
                    @if (Model.DatasTurma.Any())
                    {
                        for (var i = 0; i < Model.DatasTurma.Count; i++)
                        {
                            var data = Model.DatasTurma[i];
                            var duracao = i < Model.DuracoesTurma.Count ? Model.DuracoesTurma[i] : 1;
                            <div class="input-group data-turma-item">
                                <input name="DatasTurma" class="form-control" type="datetime-local" value="@(data.HasValue ? data.Value.ToString("yyyy-MM-ddTHH:mm") : "")" />
                                <span class="input-group-text">Duração</span>
                                <input name="DuracoesTurma" class="form-control" type="number" min="0.25" max="24" step="0.25" value="@(duracao ?? 1)" />
                                <span class="input-group-text">h</span>
                                <button type="button" class="btn btn-outline-danger remover-data" title="Remover data">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="input-group data-turma-item">
                            <input name="DatasTurma" class="form-control" type="datetime-local" />
                            <span class="input-group-text">Duração</span>
                            <input name="DuracoesTurma" class="form-control" type="number" min="0.25" max="24" step="0.25" value="1" />
                            <span class="input-group-text">h</span>
                            <button type="button" class="btn btn-outline-danger remover-data" title="Remover data">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    }
                </div>
                <span asp-validation-for="DatasTurma" class="text-danger small"></span>
                <span asp-validation-for="DuracoesTurma" class="text-danger small d-block"></span>
                <button type="button" id="adicionarData" class="btn btn-outline-secondary btn-sm mt-2">
                    <i class="fas fa-plus me-1"></i> Adicionar Data
                </button>
            </div>

            <div class="mb-3">
                <label class="form-label form-label-dk">Status (calculado automaticamente)</label>
                <div id="statusPreview" class="status-display" style="background:#e9ecef; color:#6c757d;">
                    <i class="fas fa-clock"></i> —
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="Turma.DiasDaSemana" class="form-label form-label-dk">Dias da Semana</label>
                    <input asp-for="Turma.DiasDaSemana" class="form-control" />
                    <span asp-validation-for="Turma.DiasDaSemana" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Turma.InstrutorId" class="form-label form-label-dk">Instrutor</label>
                    <select asp-for="Turma.InstrutorId" class="form-select" asp-items="ViewBag.InstrutorId">
                        <option value="">— Selecione (opcional) —</option>
                    </select>
                </div>
            </div>

            <div class="section-divider"></div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-dk-primary btn-lg px-4">
                    <i class="fas fa-save me-1"></i> Salvar
                </button>
                <a asp-page="Index" class="btn btn-dk-secondary btn-lg px-4">
                    <i class="fas fa-arrow-left me-1"></i> Voltar
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function calcularStatus() {
            const inicio = new Date(document.getElementById('dtInicio').value);
            const fim = new Date(document.getElementById('dtFim').value);
            const agora = new Date();
            const el = document.getElementById('statusPreview');
            if (!document.getElementById('dtInicio').value || !document.getElementById('dtFim').value) return;
            if (fim < agora) {
                el.innerHTML = '<i class="fas fa-check-circle"></i> Concluída';
                el.style.background = '#28a745'; el.style.color = '#fff';
            } else if (inicio <= agora && fim >= agora) {
                el.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Em andamento';
                el.style.background = '#e6a817'; el.style.color = '#fff';
            } else {
                el.innerHTML = '<i class="fas fa-calendar-alt"></i> Futura';
                el.style.background = '#0d6efd'; el.style.color = '#fff';
            }
        }
        document.getElementById('dtInicio').addEventListener('change', calcularStatus);
        document.getElementById('dtFim').addEventListener('change', calcularStatus);
        calcularStatus();

        document.getElementById('adicionarData').addEventListener('click', function () {
            const item = document.createElement('div');
            item.className = 'input-group data-turma-item';
            item.innerHTML = `
                <input name="DatasTurma" class="form-control" type="datetime-local" />
                <span class="input-group-text">Duração</span>
                <input name="DuracoesTurma" class="form-control" type="number" min="0.25" max="24" step="0.25" value="1" />
                <span class="input-group-text">h</span>
                <button type="button" class="btn btn-outline-danger remover-data" title="Remover data">
                    <i class="fas fa-trash"></i>
                </button>`;
            document.getElementById('datasTurma').appendChild(item);
        });

        document.getElementById('datasTurma').addEventListener('click', function (event) {
            const button = event.target.closest('.remover-data');
            if (!button) return;
            const items = document.querySelectorAll('.data-turma-item');
            if (items.length === 1) {
                button.closest('.data-turma-item').querySelector('input').value = '';
                button.closest('.data-turma-item').querySelector('input[name="DuracoesTurma"]').value = '1';
                return;
            }
            button.closest('.data-turma-item').remove();
        });
    </script>
}
